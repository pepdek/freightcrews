---
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/global.css";
import serif from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import serifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import inter from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import { SITE } from "../config";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonld?: object[];
}
const { title, description, noindex = false, jsonld = [] } = Astro.props;
const url = new URL(Astro.url.pathname, SITE.DOMAIN).href;
const image = new URL("/og.png", SITE.DOMAIN).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FreightCrews: AI agents for small freight brokerages. Yours to keep." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#f5f2eb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {[serif, serifItalic, inter].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {SITE.PLAUSIBLE_DOMAIN && <script is:inline defer data-domain={SITE.PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js" />}
    {jsonld.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...data }).replace(/</g, "\\u003c")} />
    ))}
  </head>
  <body>
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    <slot name="footer" />
    <script>
      // Scroll reveal. Sections already on screen are left alone, so nothing flashes.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.replace("reveal", "reveal-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -40px 0px" },
        );
        for (const section of document.querySelectorAll("main > section")) {
          if (section.getBoundingClientRect().top < innerHeight) continue;
          section.classList.add("reveal");
          io.observe(section);
        }
      }
    </script>
  </body>
</html>
