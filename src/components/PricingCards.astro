---
import Check from "@lucide/astro/icons/check";
import Button from "./Button.astro";
import Card from "./Card.astro";
import { OFFERS } from "../data/pricing";
import { BOOK_HREF } from "../lib";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const Heading = compact ? "h3" : "h2";
---

<ul class:list={["offers", { compact }]}>
  {OFFERS.map((offer) => (
    <Card as="li" class="offer">
      <Heading class="name">{offer.name}</Heading>
      <p class="price">{offer.price}</p>
      <ul class="features">
        {(compact ? offer.features.slice(0, 2) : offer.features).map((f) => (
          <li><Check size={16} stroke-width={1.5} aria-hidden="true" /><span>{f}</span></li>
        ))}
      </ul>
      {!compact && <Button href={BOOK_HREF} variant={offer.amount === 2997 ? "primary" : "secondary"} class="cta">{offer.cta}</Button>}
    </Card>
  ))}
</ul>

<style>
  .offers { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  :global(.offer) { display: flex; flex-direction: column; max-width: none; }
  .name { font-family: var(--font-sans); font-size: 1.25rem; font-weight: 600; line-height: 1.3; letter-spacing: 0; }
  .price { font-size: 2rem; font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; margin: 12px 0 20px; font-variant-numeric: tabular-nums; }
  .features { border-top: 1px solid var(--line); padding-top: 12px; }
  .features li { display: flex; gap: 10px; padding-block: 6px; font-size: 0.9375rem; line-height: 1.5; }
  .features :global(svg) { flex: none; margin-top: 3px; }
  .offers :global(.cta) { margin-top: auto; }
  .features { margin-bottom: 24px; }
  .compact .features { margin-bottom: 0; }
  @media (min-width: 640px) { .offers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) {
    .offers { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    :global(.offer.card) { padding: 24px; }
  }
</style>
