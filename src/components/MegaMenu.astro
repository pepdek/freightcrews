---
import ChevronDown from "@lucide/astro/icons/chevron-down";

interface Props {
  label: string;
  columns: { title: string; links: { name: string; href: string }[]; more?: { name: string; href: string } }[];
  all: { name: string; href: string };
  wide?: boolean;
}
const { label, columns, all, wide = false } = Astro.props;
---

{/* name= makes the menus exclusive without JavaScript. */}
<details class:list={["mega", { wide }]} name="main-menu" data-mega={label}>
  <summary>{label} <ChevronDown size={16} stroke-width={1.5} aria-hidden="true" /></summary>
  <div class="panel">
    <div class="cols">
      {columns.map((column) => (
        <div class="col">
          <p class="mono label">{column.title}</p>
          <ul>
            {column.links.map((l) => <li><a href={l.href}>{l.name}</a></li>)}
          </ul>
          {column.more && <a class="link more" href={column.more.href}>{column.more.name} →</a>}
        </div>
      ))}
    </div>
    <a class="link all" href={all.href}>{all.name} →</a>
  </div>
</details>

<script>
  // Native <details> handles clicks. This adds: open on keyboard focus, close on leave/Escape/outside click.
  for (const mega of document.querySelectorAll<HTMLDetailsElement>("[data-mega]")) {
    const summary = mega.querySelector("summary")!;
    let returning = false;
    summary.addEventListener("focus", () => {
      if (!returning && summary.matches(":focus-visible")) mega.open = true;
    });
    mega.addEventListener("focusout", (e) => {
      if (e.relatedTarget && !mega.contains(e.relatedTarget as Node)) mega.open = false;
    });
    mega.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !mega.open) return;
      mega.open = false;
      returning = true;
      summary.focus();
      returning = false;
    });
    document.addEventListener("click", (e) => {
      if (!mega.contains(e.target as Node)) mega.open = false;
    });
  }
</script>

<style>
  .mega { position: relative; }
  summary { display: flex; align-items: center; gap: 4px; list-style: none; cursor: pointer; font-size: 0.9375rem; padding: 10px 0; border-radius: 2px; white-space: nowrap; }
  summary::-webkit-details-marker { display: none; }
  .mega[open] summary :global(svg) { transform: rotate(180deg); }
  .panel { position: absolute; top: calc(100% + 12px); left: -28px; width: 300px; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 28px; }
  .label { text-transform: uppercase; color: var(--ink-2); margin-bottom: 8px; }
  ul a { display: block; padding: 6px 0; font-size: 0.9375rem; line-height: 1.4; text-decoration: none; }
  ul a:hover { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; }
  .more { display: inline-block; margin-top: 12px; padding-block: 4px; font-size: 0.9375rem; }
  .all { display: block; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.9375rem; }
  /* The wide panel spans the header container, one column per business. */
  .wide { position: static; }
  .wide .panel { left: 24px; right: 24px; top: calc(100% - 4px); width: auto; padding: 0; }
  .wide .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .wide .col { display: flex; flex-direction: column; align-items: flex-start; padding: 28px; }
  .wide .col + .col { border-left: 1px solid var(--line); }
  .wide .col ul { margin-bottom: auto; }
  .wide .all { margin: 0; padding: 18px 28px; }
  @media (min-width: 768px) { .wide .panel { left: 40px; right: 40px; } }
</style>
