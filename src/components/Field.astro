---
interface Props {
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "textarea" | "select";
  required?: boolean;
  autocomplete?: string;
  options?: { value: string; label: string }[];
  wide?: boolean;
}
const { name, label, type = "text", required = false, autocomplete, options = [], wide = false } = Astro.props;
const id = `f-${name}`;
const shared = { id, name, required, autocomplete };
---

<div class:list={["field", { wide }]}>
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  {type === "textarea" ? (
    <textarea {...shared} rows="4" />
  ) : type === "select" ? (
    <select {...shared}>
      <option value="">Choose one</option>
      {options.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  ) : (
    <input {...shared} type={type} />
  )}
  <p class="error" id={`${id}-error`} hidden></p>
</div>
