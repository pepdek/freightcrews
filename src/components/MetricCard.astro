---
import Card from "./Card.astro";
import Tag from "./Tag.astro";

interface Props {
  value: string;
  unit?: string;
  caption: string;
  label?: string;
}
const { value, unit, caption, label } = Astro.props;
---

<Card class="metric">
  {label && <Tag>{label}</Tag>}
  <p class="figure"><span class="numeral">{value}</span>{unit && <span class="unit">{unit}</span>}</p>
  <p class="small muted">{caption}</p>
</Card>

<style>
  .figure { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.4ch; margin: 16px 0 8px; }
  .numeral { font-family: var(--font-serif); font-size: 3.5rem; line-height: 1; }
  .unit { font-size: 0.9375rem; }
</style>
