---
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Button from "./Button.astro";
import MegaMenu from "./MegaMenu.astro";
import { SITE } from "../config";
import { BOOK_HREF } from "../lib";
import { agentLinks, nicheLinks, proofEntry } from "../content";

const proof = await proofEntry();
const agents = await agentLinks();
const niches = await nicheLinks();
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? "page" : undefined);
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container-x bar">
    <a class="wordmark" href="/" aria-current={current("/")}><span class="square" aria-hidden="true"></span>{SITE.BRAND}</a>

    <nav class="desktop" aria-label="Main">
      <a href="/how-it-works/" aria-current={current("/how-it-works/")}>How it works</a>
      <MegaMenu agents={agents} niches={niches} />
      <a href="/pricing/" aria-current={current("/pricing/")}>Pricing</a>
      {proof && <a href="/proof/" aria-current={current("/proof/")}>Proof</a>}
      <a href="/claude-use-cases/" aria-current={current("/claude-use-cases/")}>Learn</a>
    </nav>
    <Button href={BOOK_HREF} class="desktop-cta">Book a teardown</Button>

    <details class="mobile" data-mobile-nav>
      <summary aria-label="Menu">
        <span class="when-closed"><Menu size={24} stroke-width={1.5} aria-hidden="true" /></span>
        <span class="when-open"><X size={24} stroke-width={1.5} aria-hidden="true" /></span>
      </summary>
      <nav class="sheet" aria-label="Mobile">
        <div class="sheet-scroll">
          <a class="row" href="/how-it-works/" aria-current={current("/how-it-works/")}>How it works</a>
          <div class="group">
            <p class="row">Agents <ChevronDown size={18} stroke-width={1.5} aria-hidden="true" /></p>
            <p class="mono label">By business</p>
            <ul>{niches.map((n) => <li><a href={n.href}>{n.name}</a></li>)}</ul>
            <p class="mono label">By job</p>
            <ul>{agents.map((a) => <li><a href={a.href}>{a.name}</a></li>)}</ul>
            <a class="link link-block" href="/agents/">See all agents →</a>
          </div>
          <a class="row" href="/pricing/" aria-current={current("/pricing/")}>Pricing</a>
          {proof && <a class="row" href="/proof/">Proof</a>}
          <a class="row" href="/claude-use-cases/" aria-current={current("/claude-use-cases/")}>Learn</a>
        </div>
        <div class="sheet-cta"><Button href={BOOK_HREF}>Book a teardown</Button></div>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const onScroll = () => header.classList.toggle("scrolled", scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mobile sheet: keep focus out of the page behind it. Opening works without this.
  const sheet = document.querySelector<HTMLDetailsElement>("[data-mobile-nav]")!;
  sheet.addEventListener("toggle", () => {
    for (const el of document.querySelectorAll<HTMLElement>("main, body > footer")) el.inert = sheet.open;
  });
  sheet.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !sheet.open) return;
    sheet.open = false;
    sheet.querySelector("summary")!.focus();
  });
  matchMedia("(min-width: 900px)").addEventListener("change", () => (sheet.open = false));
</script>

<style>
  .skip { position: absolute; left: 16px; top: -80px; z-index: 60; background: var(--ink); color: var(--paper); padding: 10px 16px; border-radius: 10px; }
  .skip:focus { top: 10px; }
  .site-header { position: sticky; top: 0; z-index: 40; height: 64px; border-bottom: 1px solid transparent; }
  /* The fill lives on a pseudo-element: backdrop-filter on the header itself would trap the fixed mobile sheet. */
  .site-header::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--paper); }
  .site-header.scrolled { border-bottom-color: var(--line); }
  .site-header.scrolled::before { background: color-mix(in srgb, var(--paper) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .site-header:has(details[data-mobile-nav][open])::before { background: var(--paper); backdrop-filter: none; -webkit-backdrop-filter: none; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 63px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1.0625rem; text-decoration: none; min-height: 44px; }
  .square { width: 10px; height: 10px; background: var(--signal); }
  .desktop { display: none; }
  .bar :global(.desktop-cta) { display: none; }
  .desktop > a { font-size: 0.9375rem; text-decoration: none; padding: 10px 0; }
  .desktop > a:hover, .desktop > a[aria-current] { text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 8px; }

  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .mobile summary { display: grid; place-items: center; width: 48px; height: 48px; margin-right: -12px; border-radius: 10px; }
  .when-open, .mobile[open] .when-closed { display: none; }
  .mobile[open] .when-open { display: block; }
  .sheet { position: fixed; inset: 64px 0 0 0; display: flex; flex-direction: column; background: var(--paper); border-top: 1px solid var(--line); }
  .sheet-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 8px 24px 24px; }
  .row { display: flex; align-items: center; gap: 8px; min-height: 56px; border-bottom: 1px solid var(--line); font-weight: 500; text-decoration: none; }
  .group { border-bottom: 1px solid var(--line); padding-bottom: 12px; }
  .group .row { border: 0; }
  .label { text-transform: uppercase; color: var(--ink-2); margin-top: 8px; }
  .group ul a { display: flex; align-items: center; min-height: 44px; text-decoration: none; }
  .sheet-cta { padding: 16px 24px calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); }
  .sheet-cta :global(.btn) { width: 100%; }
  :global(body:has(details[data-mobile-nav][open])) { overflow: hidden; }

  @media (min-width: 900px) {
    .mobile { display: none; }
    .desktop { display: flex; align-items: center; gap: 32px; }
    .bar :global(.desktop-cta) { display: inline-flex; min-height: 40px; }
  }
</style>
