---
import { Image } from "astro:assets";
import { SITE } from "../config";
import { INITIALS, asset } from "../lib";

const photo = asset(SITE.FOUNDER_PHOTO);
---

{photo ? (
  <Image class="portrait" src={photo} alt={SITE.FOUNDER_NAME} width={400} height={500} format="avif" fit="cover" />
) : (
  <div class="portrait monogram" aria-hidden="true">{INITIALS}</div>
)}

<style>
  .portrait { width: 100%; max-width: 320px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; }
  /* A deliberate monogram, not an empty photo frame: small, square, with the accent rule. */
  .monogram { position: relative; display: grid; place-items: center; width: 160px; height: 160px; aspect-ratio: auto; border: 1px solid currentColor; font-size: 2.5rem; font-weight: 500; line-height: 1; letter-spacing: 0.04em; }
  .monogram { background: var(--paper-2); }
  :global(.night) .monogram { background: transparent; }
  .monogram::after { content: ""; position: absolute; left: 20px; bottom: 20px; width: 16px; height: 2px; background: var(--signal); }
  @media (min-width: 900px) { .monogram { width: 208px; height: 208px; font-size: 3.5rem; } }
</style>
