---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Card from "./Card.astro";
import Tag from "./Tag.astro";

interface Props {
  name: string;
  oneliner: string;
  frees: string;
  href: string;
  level?: "h2" | "h3";
}
const { name, oneliner, frees, href, level: Heading = "h3" } = Astro.props;
---

<Card as="li" class="agent card-link">
  <div class="top">
    <Heading class="name"><a href={href}>{name}</a></Heading>
    <ArrowRight size={20} stroke-width={1.5} aria-hidden="true" />
  </div>
  <p class="small">{oneliner}</p>
  <div class="bottom"><Tag>{frees}</Tag></div>
</Card>

<style>
  :global(.agent) { position: relative; display: flex; flex-direction: column; max-width: none; }
  .name { font-family: var(--font-sans); font-size: 1.25rem; font-weight: 600; line-height: 1.3; letter-spacing: 0; }
  a { text-decoration: none; }
  /* The whole card is the hit area; the focus ring follows it. */
  a::after { content: ""; position: absolute; inset: 0; border-radius: 10px; }
  a:focus-visible { outline: none; }
  a:focus-visible::after { outline: 2px solid var(--signal); outline-offset: 2px; }
  p { margin-top: 12px; color: var(--ink-2); }
  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .top :global(svg) { flex: none; margin-top: 3px; }
  .bottom { margin-top: auto; padding-top: 24px; }
  /* Tight enough that the longest "Frees up" line stays on one row in a three-up card. */
  :global(.agent.card) { padding: 20px; }
  @media (min-width: 640px) { :global(.agent.card) { padding: 24px; } }
  .bottom :global(.tag) { padding-inline: 8px; letter-spacing: -0.02em; }
</style>
