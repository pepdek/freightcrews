---
interface Props {
  title: string;
  italic?: string;
  lead?: string;
}
const { title, italic, lead } = Astro.props;
---

<section class="page-head">
  <div class="container-x">
    <slot name="above" />
    <h1>{title}{italic && <>{" "}<em>{italic}</em></>}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head { padding-block: clamp(56px, 8vw, 112px) clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--line); }
  h1 { max-width: 17em; }
</style>
